{
  "name": "zapret-desktop",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --tsconfig ui/tsconfig.json",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "prepare:engines": "cargo run -p zbuild --locked -- prepare-windows",
    "prepare:engines:macos": "python3 scripts/prepare_engines.py --platform macos",
    "verify:release": "python3 scripts/release_gate.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "overlayscrollbars": "2.17.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  }
}
