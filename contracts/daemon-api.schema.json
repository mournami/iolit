{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DaemonApi",
  "description": "Schema root describes both directions of the daemon transport.",
  "type": "object",
  "properties": {
    "request": {
      "$ref": "#/$defs/DaemonCommand"
    },
    "response": {
      "$ref": "#/$defs/ApiResponse"
    }
  },
  "required": [
    "request",
    "response"
  ],
  "$defs": {
    "ApiResponse": {
      "description": "Retain the existing local IPC success/error envelope.",
      "type": "object",
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DaemonResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    },
    "BundleStatus": {
      "description": "Strategy bundle in use and the state of signed bundle updates.",
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "flowseal": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_check": {
          "description": "Unix seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "last_update": {
          "description": "Unix seconds of the last switch to a new bundle.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "updates_enabled": {
          "description": "False when this build has no bundle public key: updates never run.",
          "type": "boolean"
        },
        "version": {
          "description": "Downloaded bundle version; `None` while the installer's bundle is used.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "updates_enabled"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "ipv6": {
          "type": "boolean"
        },
        "packet_injection": {
          "type": "boolean"
        },
        "tcp": {
          "type": "boolean"
        },
        "udp": {
          "type": "boolean"
        }
      },
      "required": [
        "tcp",
        "udp",
        "ipv6",
        "packet_injection"
      ]
    },
    "DaemonCommand": {
      "description": "Commands are fixed; no executable or filesystem path is accepted over IPC.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "snapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "enable"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "disable"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "strategy_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "strategy_id"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "set_strategy"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "diagnose"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "select_strategy"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "cancel_operation"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "doctor"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "domain"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "add_domain"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        },
        {
          "description": "Removes one domain from the user list; accepts what `AddDomain` accepts.",
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "domain"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "remove_domain"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        },
        {
          "description": "The user list in readable form (Unicode for IDN). Never part of reports.",
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "domains"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "logs"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "report"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "description": "Cloudflare DNS over HTTPS on the active adapters (Windows 11); off\nrestores each adapter's previous DNS settings.",
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "enabled"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "set_secure_dns"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        }
      ]
    },
    "DaemonResponse": {
      "anyOf": [
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "$ref": "#/$defs/DoctorResult"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "$ref": "#/$defs/Report"
        },
        {
          "type": "null"
        }
      ]
    },
    "DoctorCheck": {
      "type": "object",
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "ok"
      ]
    },
    "DoctorResult": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DoctorCheck"
          }
        }
      },
      "required": [
        "checks"
      ]
    },
    "Operation": {
      "type": "object",
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "current": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProbeResult"
          }
        },
        "stage": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "winner": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "busy",
        "stage",
        "current",
        "total",
        "results"
      ]
    },
    "ProbeResult": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string"
        },
        "warning": {
          "description": "The service answered, but something outside the bypass needs the\nuser's attention (the system DNS did not know the address).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "protocol",
        "ok",
        "latency_ms",
        "detail"
      ]
    },
    "Report": {
      "description": "Deliberate allowlist: no logs, domains, warnings or address-bearing probe details.",
      "type": "object",
      "properties": {
        "app_version": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportCheck"
          }
        },
        "engine": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "packets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "platform": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string"
        }
      },
      "required": [
        "app_version",
        "platform",
        "engine",
        "running",
        "strategy",
        "capabilities",
        "packets",
        "errors",
        "checks"
      ]
    },
    "ReportCheck": {
      "type": "object",
      "properties": {
        "latency_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ok": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "required": [
        "service",
        "protocol",
        "ok",
        "latency_ms"
      ]
    },
    "SecureDns": {
      "description": "System-wide secure DNS set by the service, see `SetSecureDns`.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Turned on by this app; the previous settings are saved.",
          "type": "boolean"
        },
        "provider": {
          "description": "Resolver that answered when it was turned on, e.g. \"Cloudflare\".",
          "type": [
            "string",
            "null"
          ]
        },
        "supported": {
          "description": "Windows 11 or newer.",
          "type": "boolean"
        }
      },
      "required": [
        "supported",
        "enabled"
      ]
    },
    "ServiceStatus": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "engine": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "installed": {
          "type": "boolean"
        },
        "modified_packets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "packets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "platform": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "secure_dns": {
          "$ref": "#/$defs/SecureDns",
          "default": {
            "enabled": false,
            "supported": false
          }
        },
        "strategy": {
          "type": "string"
        },
        "uptime_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "installed",
        "running",
        "platform",
        "engine",
        "strategy",
        "uptime_secs",
        "capabilities",
        "warnings",
        "packets",
        "modified_packets",
        "errors"
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "bundle": {
          "$ref": "#/$defs/BundleStatus",
          "default": {
            "error": null,
            "flowseal": null,
            "last_check": null,
            "last_update": null,
            "updates_enabled": false,
            "version": null
          }
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "service": {
          "$ref": "#/$defs/ServiceStatus"
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Strategy"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "service",
        "strategies",
        "operation"
      ]
    },
    "Strategy": {
      "type": "object",
      "properties": {
        "arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "supported": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    }
  }
}
