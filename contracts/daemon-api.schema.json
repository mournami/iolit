{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DaemonApi",
  "description": "Schema root describes both directions of the daemon transport.",
  "type": "object",
  "properties": {
    "request": {
      "$ref": "#/$defs/DaemonCommand"
    },
    "response": {
      "$ref": "#/$defs/ApiResponse"
    }
  },
  "required": [
    "request",
    "response"
  ],
  "$defs": {
    "ApiResponse": {
      "description": "Retain the existing local IPC success/error envelope.",
      "type": "object",
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DaemonResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    },
    "AppUpdate": {
      "description": "Application updates: found and downloaded by the service, installed only\nwhen the user asks (`UpdateApp`).",
      "type": "object",
      "properties": {
        "available": {
          "description": "Newer version downloaded and verified, waiting for `UpdateApp`.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "installing": {
          "description": "The installer is running; the service is about to restart.",
          "type": "boolean"
        },
        "last_check": {
          "description": "Unix seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "installing"
      ]
    },
    "BundleStatus": {
      "description": "Strategy bundle in use and the state of signed bundle updates.",
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "flowseal": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_check": {
          "description": "Unix seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "last_update": {
          "description": "Unix seconds of the last switch to a new bundle.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "updates_enabled": {
          "description": "False when this build has no bundle public key: updates never run.",
          "type": "boolean"
        },
        "version": {
          "description": "Downloaded bundle version; `None` while the installer's bundle is used.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "updates_enabled"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "ipv6": {
          "type": "boolean"
        },
        "packet_injection": {
          "type": "boolean"
        },
        "tcp": {
          "type": "boolean"
        },
        "udp": {
          "type": "boolean"
        }
      },
      "required": [
        "tcp",
        "udp",
        "ipv6",
        "packet_injection"
      ]
    },
    "DaemonCommand": {
      "description": "Commands are fixed; no executable or filesystem path is accepted over IPC.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "snapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "enable"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "disable"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "strategy_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "strategy_id"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "set_strategy"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "diagnose"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "select_strategy"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "description": "Selection only for the checks the background check found broken,\nkeeping the current strategy for everything else.",
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "repair_strategy"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "description": "Runs the downloaded and verified installer of a newer application\nversion (`Snapshot::app`). The service and the window restart.",
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "update_app"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "cancel_operation"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "doctor"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "domain"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "add_domain"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        },
        {
          "description": "Removes one domain from the user list; accepts what `AddDomain` accepts.",
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "domain"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "remove_domain"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        },
        {
          "description": "The user list in readable form (Unicode for IDN). Never part of reports.",
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "domains"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "logs"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "const": "report"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd"
          ]
        },
        {
          "description": "Cloudflare DNS over HTTPS on the active adapters (Windows 11); off\nrestores each adapter's previous DNS settings.",
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "enabled"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "set_secure_dns"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        },
        {
          "description": "Local MTProto proxy for Telegram Desktop on `127.0.0.1`; independent of\n`Enable`/`Disable` and kept across restarts.",
          "type": "object",
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "enabled"
              ]
            },
            "cmd": {
              "type": "string",
              "const": "set_telegram_proxy"
            }
          },
          "additionalProperties": false,
          "required": [
            "cmd",
            "args"
          ]
        }
      ]
    },
    "DaemonResponse": {
      "anyOf": [
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "$ref": "#/$defs/DoctorResult"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "$ref": "#/$defs/Report"
        },
        {
          "type": "null"
        }
      ]
    },
    "DoctorCheck": {
      "type": "object",
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "ok"
      ]
    },
    "DoctorResult": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DoctorCheck"
          }
        }
      },
      "required": [
        "checks"
      ]
    },
    "Health": {
      "description": "Background check while the bypass is on: every 10 minutes and after the\nnetwork changes.",
      "type": "object",
      "properties": {
        "broken": {
          "description": "Ids of checks that passed earlier with this strategy and fail now.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_at": {
          "description": "Unix time of the last background check; 0 before the first one.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "checked_at",
        "broken"
      ]
    },
    "Operation": {
      "type": "object",
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "current": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProbeResult"
          }
        },
        "stage": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "winner": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "busy",
        "stage",
        "current",
        "total",
        "results"
      ]
    },
    "ProbeResult": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string"
        },
        "warning": {
          "description": "The service answered, but something outside the bypass needs the\nuser's attention (the system DNS did not know the address).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "protocol",
        "ok",
        "latency_ms",
        "detail"
      ]
    },
    "Report": {
      "description": "Deliberate allowlist: no logs, domains, warnings or address-bearing probe details.",
      "type": "object",
      "properties": {
        "app_version": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportCheck"
          }
        },
        "engine": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "packets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "platform": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string"
        }
      },
      "required": [
        "app_version",
        "platform",
        "engine",
        "running",
        "strategy",
        "capabilities",
        "packets",
        "errors",
        "checks"
      ]
    },
    "ReportCheck": {
      "type": "object",
      "properties": {
        "latency_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ok": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "required": [
        "service",
        "protocol",
        "ok",
        "latency_ms"
      ]
    },
    "SecureDns": {
      "description": "System-wide secure DNS set by the service, see `SetSecureDns`.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Turned on by this app; the previous settings are saved.",
          "type": "boolean"
        },
        "provider": {
          "description": "Resolver that answered when it was turned on, e.g. \"Cloudflare\".",
          "type": [
            "string",
            "null"
          ]
        },
        "supported": {
          "description": "Windows 11 or newer.",
          "type": "boolean"
        }
      },
      "required": [
        "supported",
        "enabled"
      ]
    },
    "ServiceStatus": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "engine": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "installed": {
          "type": "boolean"
        },
        "modified_packets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "packets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "platform": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "secure_dns": {
          "$ref": "#/$defs/SecureDns",
          "default": {
            "enabled": false,
            "supported": false
          }
        },
        "strategy": {
          "type": "string"
        },
        "uptime_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "installed",
        "running",
        "platform",
        "engine",
        "strategy",
        "uptime_secs",
        "capabilities",
        "warnings",
        "packets",
        "modified_packets",
        "errors"
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/AppUpdate",
          "default": {
            "available": null,
            "error": null,
            "installing": false,
            "last_check": null
          }
        },
        "bundle": {
          "$ref": "#/$defs/BundleStatus",
          "default": {
            "error": null,
            "flowseal": null,
            "last_check": null,
            "last_update": null,
            "updates_enabled": false,
            "version": null
          }
        },
        "health": {
          "$ref": "#/$defs/Health",
          "default": {
            "broken": [],
            "checked_at": 0
          }
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "service": {
          "$ref": "#/$defs/ServiceStatus"
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Strategy"
          }
        },
        "telegram": {
          "$ref": "#/$defs/TelegramProxy",
          "default": {
            "active": 0,
            "direct": 0,
            "enabled": false,
            "error": null,
            "failed": 0,
            "failed_handshake": 0,
            "failed_route": 0,
            "failed_secret": 0,
            "link": null,
            "running": false,
            "websocket": 0
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "service",
        "strategies",
        "operation"
      ]
    },
    "Strategy": {
      "type": "object",
      "properties": {
        "arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "supported": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "TelegramProxy": {
      "description": "Local proxy that carries Telegram Desktop's traffic to Telegram's own\nWebSocket gateway, see `SetTelegramProxy`.",
      "type": "object",
      "properties": {
        "active": {
          "description": "Telegram connections open now.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "direct": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "enabled": {
          "description": "Turned on by the user; kept across restarts.",
          "type": "boolean"
        },
        "error": {
          "description": "Why an enabled proxy is not running.",
          "type": [
            "string",
            "null"
          ]
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed_handshake": {
          "description": "Why the failed ones failed: no full 64-byte handshake within 10 s,\na handshake made with another secret, or no route to the datacenter.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "failed_route": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "failed_secret": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "link": {
          "description": "`tg://proxy` link with this computer's secret. Never part of reports.",
          "type": [
            "string",
            "null"
          ]
        },
        "running": {
          "description": "The local port is open.",
          "type": "boolean"
        },
        "websocket": {
          "description": "Connections since the proxy started: through the WebSocket gateway,\nstraight to a datacenter, and those that reached neither.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "running",
        "active",
        "websocket",
        "direct",
        "failed"
      ]
    }
  }
}
