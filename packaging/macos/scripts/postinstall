#!/bin/sh
set -eu
DATA="/Library/Application Support/Zapret Desktop"
BACKUP="$DATA/state/installer-user-lists"
for name in list-general-user.txt list-exclude-user.txt ipset-exclude-user.txt; do
  if [ -f "$BACKUP/$name" ]; then
    install -o root -g wheel -m 0644 "$BACKUP/$name" "$DATA/lists/$name"
    rm -f "$BACKUP/$name"
  fi
done
install -d -o root -g wheel -m 0755 /var/run/zapret-desktop
"/Library/PrivilegedHelperTools/io.zapret.desktop.engine" install-daemon \
  --label io.zapret.desktop.engine \
  --plist /Library/LaunchDaemons/io.zapret.desktop.engine.plist \
  --data "/Library/Application Support/Zapret Desktop" \
  --socket /var/run/zapret-desktop/control.sock \
  --anchor zapret-desktop --transport divert --desktop \
  --stdout /var/log/zapret-desktop.log --stderr /var/log/zapret-desktop.err.log
